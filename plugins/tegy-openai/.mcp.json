{
  "mcpServers": {
    "tegy-mcp": {
      "type": "streamable-http",
      "url": "https://mcp.tegy.io/mcp?integration=openai&delivery=text",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": [
              "tegy:review:run",
              "tegy:brief:run",
              "tegy:solve:run"
            ],
            "defaultScopes": [
              "tegy:review:run",
              "tegy:brief:run",
              "tegy:solve:run"
            ]
          }
        }
      }
    }
  }
}
